[column]
    ui = auto
[color]
    diff = auto
    status = auto
    branch = auto
    grep = auto
[core]
    excludesfile = /Users/james/.gitignore
[alias]
    a = add
    br = branch
    cdiff = log -p -1 --stat
    ci = commit
    co = checkout
    cp = cherry-pick
    cpp = !sh -c "git log -p -1 $1 "
    d = diff
    fixup = commit --amend --no-edit
    gr = grep --color -p -n --full-name
    lg = log --graph --pretty=format:'%Cred%h%Creset %G? -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
    mg = merge --no-ff --no-edit
    p = log -1 -p
    st = status
    sw = switch
    u = checkout --
[user]
	name = James Socol
	email = me@jamessocol.com
[github]
    username = jsocol
[push]
	default = upstream
[pull]
	rebase = true
[rebase]
	autoStash = true
[init]
	defaultBranch = main
[url "git@github.com:"]
	insteadof = https://github.com/
[remote "origin"]
	prune = true
[branch]
	sort = -committerdate
[tag]
	sort = -version:refname
[commit]
	gpgsign = true
	verbose = true
[help]
	autocorrect = prompt
[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true
	renames = true
[rerere]
	enabled = true
	autoupdate = true
[merge]
	conflictStyle = zdiff3
