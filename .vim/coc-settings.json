{
  "basedpyright.analysis.autoImportCompletions": true,
  "basedpyright.analysis.useLibraryCodeForTypes": true,
  "coc.source.ultisnips.enable": true,
  "coc.source.ultisnips.priority": 100,
  "diagnostic.displayByAle": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": true
  },
  "eslint.autoFixOnSave": true,
  "go.goplsOptions": {
    "gofumpt": true
  },
  "html.format.templating": true,
  "languageserver": {
    "cue": {
      "args": [
        "lsp",
        "serve"
      ],
      "command": "cue",
      "filetypes": [
        "cue"
      ],
      "maxRestartCount": 3,
      "rootPatterns": [
        "cue.mod"
      ]
    },
    "dockerfile": {
      "args": [
        "--stdio"
      ],
      "command": "docker-langserver",
      "filetypes": [
        "dockerfile"
      ]
    },
    "ruby-lsp": {
      "command": "ruby-lsp",
      "experimentalFeaturesEnabled": false,
      "featuresConfiguration": {
        "inlayHint": {
          "implicitHashValue": true,
          "implicitRescue": true
        }
      },
      "filetypes": [
        "ruby"
      ],
      "formatter": "auto",
      "indexing": {
        "excludedGems": [],
        "excludedMagicComments": [
          "compiled:true"
        ],
        "excludedPatterns": [],
        "includedPatterns": []
      },
      "initializationOptions": {
        "enabledFeatures": {
          "codeActions": true,
          "codeLens": true,
          "completion": true,
          "definition": true,
          "diagnostics": true,
          "documentHighlights": true,
          "documentLink": true,
          "documentSymbols": true,
          "foldingRanges": true,
          "formatting": true,
          "hover": true,
          "inlayHint": true,
          "onTypeFormatting": true,
          "selectionRanges": true,
          "semanticHighlighting": true,
          "signatureHelp": true,
          "typeHierarchy": true,
          "workspaceSymbol": true
        }
      },
      "linters": [
        "standardrb"
      ]
    },
    "terraform": {
      "args": [
        "serve"
      ],
      "command": "terraform-lsp",
      "filetypes": [
        "terraform",
        "tf"
      ],
      "initializationOptions": {}
    }
  },
  "workspace.rootPatterns": [
    ".git",
    ".hg",
    ".projections.json"
  ],
  "yaml.format.printWidth": 120,
  "yaml.format.proseWrap": "always"
}
